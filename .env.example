OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
DATABASE_URL=sqlite:///data/life_inbox.db

# --- Sign-in (Google) ---------------------------------------------------
# LIFE_INBOX_AUTH_MODE=dev      -> local dev login (default, local only)
# LIFE_INBOX_AUTH_MODE=google   -> real Google sign-in (required for beta/production)
LIFE_INBOX_AUTH_MODE=dev
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public address of the app; Google redirects back to <this>/api/auth/google/callback
LIFE_INBOX_PUBLIC_URL=http://localhost:8000
# Optional invite list (comma separated). Empty = any verified Google account.
LIFE_INBOX_ALLOWED_EMAILS=
LIFE_INBOX_ALLOWED_EMAIL_DOMAINS=
# 32+ random characters (beta/production). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
LIFE_INBOX_SESSION_SECRET=
